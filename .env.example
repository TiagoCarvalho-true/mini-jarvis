# ===== API =====
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ===== Voz =====
WAKE_WORD=jarvis

# ===== Microfone =====
MIC_CALIBRATION_TIME=3
MIC_SILENCE_DURATION=2.5
MIC_MAX_COMMAND_DURATION=20

# ===== Palmas =====
CLAP_DETECTION_ENABLED=true
CLAP_THRESHOLD=0.25
CLAP_MIN_INTERVAL=0.15

# ===== Visao =====
FACE_RECOGNITION_ENABLED=true
CAMERA_SOURCE=0
VISION_MODE=on_demand

# ===== IoT =====
ESP32_IP=192.168.1.100

# ===== Ruido (opcional) =====
NOISE_REDUCTION=false

# ===== Log =====
LOG_LEVEL=INFO
